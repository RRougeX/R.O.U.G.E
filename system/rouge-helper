#!/bin/bash
# R.O.U.G.E system helper. Installed to /usr/local/lib/rouge/rouge-helper,
# owned by root, and allowed through sudo without a password for the R.O.U.G.E
# user only. It does a fixed set of things and checks every argument.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

die() { echo "$*" >&2; exit 1; }
onoff() { [[ "${1:-}" == on || "${1:-}" == off ]] || die "expected on or off"; }

governor() {
  local g="$1" f
  for f in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    [ -w "$f" ] || continue
    if grep -qw "$g" "$(dirname "$f")/scaling_available_governors" 2>/dev/null; then echo "$g" > "$f"; fi
  done
}

brightness() { # percent
  local d max
  for d in /sys/class/backlight/*; do
    [ -d "$d" ] || continue
    max=$(cat "$d/max_brightness")
    echo $(( max * $1 / 100 > 0 ? max * $1 / 100 : 1 )) > "$d/brightness"
    return 0
  done
  die "This screen has no software brightness control. Use the buttons on the screen."
}

case "${1:-}" in
  powersave)
    onoff "${2:-}"
    if [ "$2" = on ]; then
      governor powersave
      rfkill block bluetooth 2>/dev/null || true
      # dim to 40% if the screen supports it; ignore if not
      for d in /sys/class/backlight/*; do [ -d "$d" ] && brightness 40 && break; done || true
      # turn off the activity LEDs
      for l in /sys/class/leds/ACT /sys/class/leds/led0 /sys/class/leds/PWR /sys/class/leds/led1; do
        [ -w "$l/trigger" ] && echo none > "$l/trigger" && echo 0 > "$l/brightness"
      done 2>/dev/null || true
    else
      governor ondemand
      rfkill unblock bluetooth 2>/dev/null || true
      for d in /sys/class/backlight/*; do [ -d "$d" ] && brightness 100 && break; done || true
      [ -w /sys/class/leds/ACT/trigger ] && echo mmc0 > /sys/class/leds/ACT/trigger 2>/dev/null || true
      [ -w /sys/class/leds/led0/trigger ] && echo mmc0 > /sys/class/leds/led0/trigger 2>/dev/null || true
    fi ;;
  wifi)
    onoff "${2:-}"
    if command -v nmcli >/dev/null; then nmcli radio wifi "$2"
    elif [ "$2" = on ]; then rfkill unblock wifi; else rfkill block wifi; fi ;;
  bluetooth)
    onoff "${2:-}"
    if [ "$2" = on ]; then rfkill unblock bluetooth; else rfkill block bluetooth; fi ;;
  brightness)
    [[ "${2:-}" =~ ^[0-9]{1,3}$ ]] && [ "$2" -ge 5 ] && [ "$2" -le 100 ] || die "brightness 5-100"
    brightness "$2" ;;
  hotspot)
    command -v nmcli >/dev/null || die "NetworkManager (nmcli) is not installed"
    if [ "${2:-}" = on ]; then
      [[ "${3:-}" =~ ^[A-Za-z0-9\ _.-]{1,32}$ ]] || die "bad network name"
      [[ "${4:-}" =~ ^[A-Za-z0-9\ _.\!@#%^*+=-]{8,63}$ ]] || die "bad password"
      nmcli radio wifi on
      nmcli device wifi hotspot ifname wlan0 con-name Hotspot ssid "$3" password "$4" >/dev/null
    elif [ "${2:-}" = off ]; then
      nmcli connection down Hotspot >/dev/null 2>&1 || true
    else die "hotspot on|off"; fi ;;
  settime)
    [[ "${2:-}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || die "time must be YYYY-MM-DD HH:MM:SS"
    date -s "$2" >/dev/null
    command -v hwclock >/dev/null && [ -e /dev/rtc0 ] && hwclock -w 2>/dev/null || true ;;
  shutdown) systemctl poweroff ;;
  reboot)   systemctl reboot ;;
  *) die "usage: rouge-helper powersave|wifi|bluetooth on|off, brightness N, hotspot on SSID PASS|off, settime 'YYYY-MM-DD HH:MM:SS', shutdown, reboot" ;;
esac
