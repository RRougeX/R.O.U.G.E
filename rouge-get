PMTILES="$DATA/bin/pmtiles"

ensure_pmtiles() {
  if command -v pmtiles >/dev/null; then PMTILES="$(command -v pmtiles)"; return 0; fi
  [ -x "$PMTILES" ] && return 0
  say "Getting the pmtiles map tool (one time)"
  local pat urls url tmp
  case "$(uname -m)" in
    aarch64|arm64) pat='arm64|aarch64' ;;
    armv6l|armv7l) pat='armv6|armv7|_arm[._]' ;;
    *) pat='x86_64|amd64' ;;
  esac
  urls="$(curl -fsSL https://api.github.com/repos/protomaps/go-pmtiles/releases/latest \
          | grep -oE '"browser_download_url": *"[^"]+"' | cut -d'"' -f4)"
  url="$(printf '%s\n' "$urls" | grep -i linux | grep -iE "$pat" | grep -E '\.(tar\.gz|tgz|zip)$' | head -1 || true)"
  [ -n "$url" ] || { warn "No pmtiles download for this CPU. Get it from github.com/protomaps/go-pmtiles/releases and put it in $DATA/bin/"; return 1; }
  tmp="$(mktemp -d)"
  curl -fsSL "$url" -o "$tmp/p"
  case "$url" in *.zip) unzip -q "$tmp/p" -d "$tmp" ;; *) tar -xzf "$tmp/p" -C "$tmp" ;; esac
  install -m 755 "$(find "$tmp" -type f -name pmtiles | head -1)" "$PMTILES"
  rm -rf "$tmp"
  ok "pmtiles $("$PMTILES" version 2>/dev/null | head -1)"
}

latest_build() {
  local d i
  for i in $(seq 0 20); do
    d="$(date -u -d "-$i day" +%Y%m%d)"
    if curl -fsSI -m 15 -o /dev/null "https://build.protomaps.com/$d.pmtiles"; then
      echo "https://build.protomaps.com/$d.pmtiles"; return 0
    fi
  done
  return 1
}

get_map() { # name bbox maxzoom
  local name="$1" bbox="$2" maxz="${3:-15}" src out file
  file="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-\+/-/g;s/^-//;s/-$//').pmtiles"
  out="$DATA/maps/$file"
  ensure_pmtiles || return 0
  printf '  Finding the newest world map build... '
  src="$(latest_build)" || { echo; warn "Could not reach build.protomaps.com"; return 0; }
  echo "${src##*/}"
  echo "  Area: $bbox   Detail: zoom 0-$maxz"
  "$PMTILES" extract "$src" "$out" --bbox="$bbox" --maxzoom="$maxz" --dry-run 2>&1 | grep -iE 'size|tiles|bytes' | tail -3 | sed 's/^/  /' || true
  [ -f "$out" ] && warn "$file already exists and will be replaced."
  yes "Download this map?" || return 0
  "$PMTILES" extract "$src" "$out.part" --bbox="$bbox" --maxzoom="$maxz" --download-threads=4
  mv -f "$out.part" "$out"
  ok "saved maps/$file ($(human "$(stat -c %s "$out")"))"
}

pad_bbox() { awk -F, -v p="${2:-0.2}" '{printf "%.4f,%.4f,%.4f,%.4f", $1-p, $2-p, $3+p, $4+p}' <<<"$1"; }

radius_bbox() { # lat lon miles
  awk -v la="$1" -v lo="$2" -v mi="$3" 'BEGIN{pi=atan2(0,-1); d=mi/69.0; e=d/cos(la*pi/180);
    printf "%.4f,%.4f,%.4f,%.4f", lo-e, la-d, lo+e, la+d}'
}

detail_choice() {
  echo "  Detail: 1) streets and buildings, zoom 15 (biggest)  2) streets, zoom 14 (about half)  3) roads and towns, zoom 12 (small)" >&2
  local z; read -r -p "  Choose 1-3 [1]: " z || true
  case "$z" in 2) echo 14 ;; 3) echo 12 ;; *) echo 15 ;; esac
}

map_for_state() {
  local code="${1^^}" zoom="${2:-15}" line
  line="$(printf '%s\n' "$STATES" | awk -v c="$code" '$1==c')"
  [ -n "$line" ] || { warn "Unknown state code $1"; return 1; }
  set -- $line
  get_map "${2//_/-}" "$(pad_bbox "$3")" "$zoom"
}

menu_maps() {
  say "Offline maps (from OpenStreetMap)"
  cat <<EOF
  1) A US state
  2) Around a point (latitude, longitude and a radius)
  3) A box you type (min lon, min lat, max lon, max lat)
  4) Whole world overview, zoom 0-6 (countries, cities, main roads; about 1 GB)
EOF
  echo "  Tip: get a detailed map of your area plus the world overview. Each one shows up in the Maps menu."
  read -r -p "  Choose 1-4 (Enter to skip): " c || true
  case "$c" in
    1) printf '%s\n' "$STATES" | awk '{printf "  %s %-15s", $1, $2; if (NR%4==0) print ""} END{print ""}' | tr '_' ' '
       read -r -p "  Two-letter state code: " s || true
       [ -n "$s" ] && { z="$(detail_choice)"; map_for_state "$s" "$z"; } ;;
    2) read -r -p "  Name for this map (e.g. Home): " n || true
       read -r -p "  Latitude, longitude (e.g. 43.16, -77.61): " ll || true
       read -r -p "  Radius in miles [50]: " r || true
       la="$(echo "$ll" | cut -d, -f1 | tr -d ' ')"; lo="$(echo "$ll" | cut -d, -f2 | tr -d ' ')"
       [[ "$la" =~ ^-?[0-9.]+$ && "$lo" =~ ^-?[0-9.]+$ ]] || { warn "Couldn't read those coordinates"; return 0; }
       z="$(detail_choice)"; get_map "${n:-Area}" "$(radius_bbox "$la" "$lo" "${r:-50}")" "$z" ;;
    3) read -r -p "  Name for this map: " n || true
       read -r -p "  Box as min_lon,min_lat,max_lon,max_lat: " bb || true
       [[ "$(tr -d ' ' <<<"$bb")" =~ ^-?[0-9.]+,-?[0-9.]+,-?[0-9.]+,-?[0-9.]+$ ]] || { warn "Couldn't read that box"; return 0; }
       z="$(detail_choice)"; get_map "${n:-Area}" "$(tr -d ' ' <<<"$bb")" "$z" ;;
    4) get_map "World" "-180,-85,180,85" 6 ;;
  esac
}

# ------------------------------------------------------------------ places
get_places() {
  say "Place names for map search (GeoNames, about 12 MB)"
  local t; t="$(mktemp -d)"
  curl -fL --progress-bar https://download.geonames.org/export/dump/cities500.zip -o "$t/c.zip"
  unzip -o -q "$t/c.zip" -d "$t"
  mv -f "$t/cities500.txt" "$DATA/places/cities500.txt"
  curl -fsSL https://download.geonames.org/export/dump/admin1CodesASCII.txt -o "$DATA/places/admin1CodesASCII.txt"
  curl -fsSL https://download.geonames.org/export/dump/countryInfo.txt -o "$DATA/places/countryInfo.txt"
  rm -rf "$t"
  ok "place names saved"
}

# ------------------------------------------------------------------ status
show_status() {
  say "What's on this device ($DATA)"
  local f any=0
  for f in "$DATA"/zim/*.zim "$DATA"/maps/*.pmtiles; do
    [ -f "$f" ] || continue; any=1
    printf '  %-50s %10s\n' "${f#"$DATA"/}" "$(human "$(stat -c %s "$f")")"
  done
  [ -f "$DATA/places/cities500.txt" ] && { any=1; echo "  places/cities500.txt (place names)"; }
  [ $any = 1 ] || echo "  Nothing downloaded yet."
  ls "$DATA"/zim/*.part "$DATA"/maps/*.part >/dev/null 2>&1 && warn "Unfinished downloads (.part) are there; run the same download again to resume."
  echo "  Free space: $(human "$(free_bytes)")"
}

# ------------------------------------------------------------------ main
case "${1:-}" in
  book)   need_internet; get_book "$2" "$3"; rescan; exit ;;
  map)    need_internet
          if [ $# -ge 3 ]; then get_map "$2" "$3" "${4:-15}"; else map_for_state "$2" "${3:-15}"; fi
          rescan; exit ;;
  world)  need_internet; get_map "World" "-180,-85,180,85" 6; rescan; exit ;;
  places) need_internet; get_places; rescan; exit ;;
  status) show_status; exit ;;
  -h|--help|help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit ;;
  "") ;;
  *) warn "Unknown command $1 (try rouge-get help)"; exit 1 ;;
esac

need_internet
while true; do
  show_status
  say "What do you want to download?"
  cat <<EOF
  1) Wikipedia
  2) Other books (medicine, survival manuals, repair, dictionary...)
  3) Maps
  4) Place names for map search
  5) Recommended starter set (Wikipedia no pictures, WikiMed, survival manuals, place names)
  q) Quit
EOF
  read -r -p "  Choose: " c || exit 0
  case "$c" in
    1) menu_wikipedia ;;
    2) menu_books ;;
    3) menu_maps; [ -f "$DATA/places/cities500.txt" ] || { yes "Also get place names so you can search the map?" && get_places; } ;;
    4) get_places ;;
    5) get_book wikipedia wikipedia_en_all_nopic; get_book other mdwiki_en_all_maxi
       get_book other zimgit-post-disaster_en; get_book other zimgit-water_en
       get_book other zimgit-medicine_en; get_places
       echo "  Now pick a map for your area:"; menu_maps ;;
    q|Q|"") rescan; exit 0 ;;
  esac
  rescan
done
