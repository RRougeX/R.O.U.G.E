  "wikivoyage|wikivoyage_en_all_maxi|Wikivoyage: travel guide, regions and towns (about 1 GB)"
  "wiktionary|wiktionary_en_all_nopic|Wiktionary: dictionary (about 8 GB)"
  "other|appropedia_en_all_maxi|Appropedia: off-grid, water, energy, building (about 1 GB)"
  "ifixit|ifixit_en_all|iFixit: repair guides (about 3 GB)"
  "other|zimgit-post-disaster_en|Post-disaster library: survival manuals (about 0.6 GB)"
  "other|zimgit-water_en|Water: purification and supply manuals (small)"
  "other|zimgit-medicine_en|Medicine: field medical manuals (small)"
  "other|zimgit-food-preparation_en|Food: preparation and preservation manuals (small)"
  "wikibooks|wikibooks_en_all_nopic|Wikibooks: textbooks (about 3 GB)"
  "gutenberg|gutenberg_en_all|Project Gutenberg: 60,000+ classic books (about 70 GB)"
)

menu_books() {
  say "Other books"
  local i=1 e
  for e in "${BOOKS[@]}"; do printf '  %2d) %s\n' "$i" "${e##*|}"; i=$((i + 1)); done
  read -r -p "  Numbers separated by spaces, e.g. 1 2 4 (Enter to skip): " picks || true
  for n in $picks; do
    [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#BOOKS[@]} ] || continue
    e="${BOOKS[$((n - 1))]}"; IFS='|' read -r d p _ <<<"$e"
    get_book "$d" "$p"
  done
}

