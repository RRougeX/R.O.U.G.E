#!/usr/bin/env bash
# rouge-get: download Wikipedia and other books, offline maps and place names.
# Run it while the Pi has internet. Everything it gets keeps working with none.
#
#   rouge-get                       menu
#   rouge-get book wikipedia wikipedia_en_all_nopic
#   rouge-get map  NY               a US state by its two-letter code
#   rouge-get map  "Home" -77.9,42.9,-77.3,43.4 [maxzoom]
#   rouge-get world                 the whole world at overview detail
#   rouge-get places                place names for map search
set -euo pipefail

DATA="${ROUGE_DATA:-}"
[ -z "$DATA" ] && [ -r /etc/default/rouge ] && DATA="$(sed -n 's/^ROUGE_DATA=//p' /etc/default/rouge)"
DATA="${DATA:-$HOME/rouge}"
ADDR="$( [ -r /etc/default/rouge ] && sed -n 's/^ROUGE_ADDR=//p' /etc/default/rouge || true)"
API="http://127.0.0.1:${ADDR##*:}"; [ "$API" = "http://127.0.0.1:" ] && API="http://127.0.0.1:8080"
KIWIX="https://download.kiwix.org/zim"
mkdir -p "$DATA"/{zim,maps,places,bin}

b()    { printf '\033[1m%s\033[0m' "$*"; }
say()  { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[33m  ! %s\033[0m\n' "$*"; }
ok()   { printf '\033[32m  ✓ %s\033[0m\n' "$*"; }
yes()  { local a; read -r -p "  $1 [Y/n] " a || true; [[ ! "$a" =~ ^[Nn] ]]; }
human() { awk -v n="${1:-0}" 'BEGIN{split("B KB MB GB TB",u);i=1;while(n>=1000&&i<5){n/=1000;i++}f=(i>3?"%.1f %s":"%.0f %s");printf f,n,u[i]}'; }
free_bytes() { df -B1 --output=avail "$DATA" | tail -1 | tr -d ' '; }
remote_size() { curl -fsSIL "$1" 2>/dev/null | tr -d '\r' | awk 'tolower($1)=="content-length:"{n=$2} END{print n+0}'; }

rescan() {
  if curl -fsS -m 30 -X POST "$API/api/rescan" >/dev/null 2>&1; then ok "R.O.U.G.E has picked up the new files"
  else warn "R.O.U.G.E isn't running; the files will be found next time it starts"; fi
}

need_internet() {
  curl -fsS -m 10 -o /dev/null https://download.kiwix.org/ 2>/dev/null \
    || curl -fsS -m 10 -o /dev/null https://github.com 2>/dev/null \
    || { warn "No internet connection. Connect to Wi-Fi or Ethernet and try again."; exit 1; }
}

# Downloads to NAME.part and renames when finished, so a half-finished file is never used.
# Re-running resumes where it stopped.
download() { # url dest
  local url="$1" dest="$2"
  wget -c -q --show-progress --tries=20 --retry-connrefused --waitretry=5 -O "$dest.part" "$url"
  mv -f "$dest.part" "$dest"
}

check_space() { # bytes
  local need="$1" have; have="$(free_bytes)"
  if [ "$need" -gt 0 ] && [ "$need" -gt $((have - 500000000)) ]; then
    warn "Needs $(human "$need") but only $(human "$have") is free."
    return 1
  fi
}

# ------------------------------------------------------------------ books
latest_zim() { # folder prefix -> newest file name
  curl -fsSL "$KIWIX/$1/" | grep -oE "$2_[0-9]{4}-[0-9]{2}\.zim" | sort -u | sort -V | tail -1
}

get_book() { # folder prefix
  local dir="$1" prefix="$2" file url size old
  printf '  Looking up %s... ' "$prefix"
  file="$(latest_zim "$dir" "$prefix" || true)"
  if [ -z "$file" ]; then echo; warn "Not found on the Kiwix server (it may have been renamed)."; return 0; fi
  echo "$file"
  if [ -f "$DATA/zim/$file" ]; then ok "already have it"; return 0; fi
  url="$KIWIX/$dir/$file"; size="$(remote_size "$url")"
  echo "  Size: $(human "$size")   Free: $(human "$(free_bytes)")"
  check_space "$size" || return 0
  yes "Download it?" || return 0
  download "$url" "$DATA/zim/$file"
  ok "saved $file"
  for old in "$DATA"/zim/"$prefix"_*.zim; do
    [ "$old" = "$DATA/zim/$file" ] || [ ! -f "$old" ] && continue
    yes "Delete the older copy $(basename "$old")?" && rm -f "$old"
  done
  return 0
}

menu_wikipedia() {
  say "Wikipedia (English)"
  cat <<EOF
  1) Full, with pictures     about 110 GB   best, needs a 256 GB card or SSD
  2) Full, no pictures       about 55 GB    every article, text only (recommended)
  3) Top articles, intro     about 12 GB    short version of every article
  4) Top 50,000 articles     about 7 GB     with pictures
  5) Tiny test (100 articles) a few MB      to check everything works
EOF
  read -r -p "  Choose 1-5 (Enter to skip): " c || true
  case "$c" in
    1) get_book wikipedia wikipedia_en_all_maxi ;;
    2) get_book wikipedia wikipedia_en_all_nopic ;;
    3) get_book wikipedia wikipedia_en_all_mini ;;
    4) get_book wikipedia wikipedia_en_top_maxi ;;
    5) get_book wikipedia wikipedia_en_100 ;;
  esac
}

